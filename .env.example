# Avishkar AI - environment variables
# Copy to .env.local and fill in real values.
# .env.local is gitignored -- never commit credentials.

# -- Chatbot (Groq) -----------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# -- Voice note delivery (Amazon SES) ----------------------------------------
# IAM user needs the ses:SendRawEmail permission.
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=

# SES region -- must be where you've verified your sender identity.
# Common options: us-east-1 | us-west-2 | eu-west-1 | ap-south-1
SES_AWS_REGION=us-east-1

# The FROM address -- must be a verified identity in SES.
SES_FROM_EMAIL=voicenotes@avishkar.app

# The TO address -- where voice notes are delivered.
# In SES Sandbox mode this address must also be verified.
SES_TO_EMAIL=info@avishkar.app

# -- Calendly embed -----------------------------------------------------------
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/yourname/audit-discovery

# -- Upstash Redis (rate limiting + visitor counter) -------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

