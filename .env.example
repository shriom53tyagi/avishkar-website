# Avishkar — environment variables
# Copy to .env.local and fill in real values.
# .env.local is gitignored — never commit credentials.

# -- Calendly embed (the only external service the site needs) ----------------
# The booking URL for the 30-minute conversation event type.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/yourname/30min

# -- Early-access waitlist (optional) -----------------------------------------
# POST endpoint that receives `{ email, source, at }`. Leave unset to accept
# valid emails in the UI without persisting them.
# EARLY_ACCESS_WEBHOOK_URL=
