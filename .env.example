# Avishkar — environment variables
# Copy to .env.local and fill in real values.
# .env.local is gitignored — never commit credentials.

# -- Calendly embed (the contact page's calendar) ------------------------------
# The booking URL for the 30-minute conversation event type. Requires a paid
# Calendly plan to remove Calendly's own branding from the embed.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/yourname/30min

# -- Form emails: early access, Letter signups, benchmark report requests -------
# /api/early-access and /api/subscribe email the team via AWS SES. Set ALL five
# (also in the production environment) or the forms accept emails silently
# without notifying anyone. SES_FROM_EMAIL must be a verified SES identity.
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
SES_AWS_REGION=
SES_FROM_EMAIL=
SES_TO_EMAIL=

# -- Insights (required for the /insights section) -----------------------------
# Neon Postgres DIRECT connection string (not the pooled/serverless one — this
# app keeps its own long-running `pg` connection pool). Run `npm run db:migrate`
# after setting this.
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# Shared secret the Avishkar Content Engine sends as `Authorization: Bearer
# <key>` when publishing, updating, or deleting an article. Generate a long
# random string and set the same value in the Content Engine.
INSIGHTS_PUBLISH_API_KEY=
