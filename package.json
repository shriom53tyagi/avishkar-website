{
  "name": "avishkar",
  "version": "0.1.0",
  "private": true,
  "description": "Avishkar — technology built around how your practice works",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env.local db/migrate.ts",
    "db:seed-legacy": "tsx --env-file=.env.local db/seed-legacy-insights.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1163.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.577.0",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
